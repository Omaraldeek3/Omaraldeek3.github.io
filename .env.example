# نطاق الإنتاج بلا شرطة أخيرة، مثل https://omaraldeek.com
# بدونه تُحذف وسوم canonical و hreflang بدل اختلاق نطاق.
NEXT_PUBLIC_SITE_URL=

# وجهة نموذج التواصل. بدونها يعيد /api/contact رمز 503
# وتعرض الواجهة حالة "غير مفعّل" بدل رسالة نجاح كاذبة.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
CONTACT_API_KEY=

# محوّل CDR المحلي لـ Cut Studio. اختياري تماماً.
# المسار /api/tools/cdr يقبل طلبات loopback فقط بحكم التصميم،
# فاستيراد CDR يعمل عند التشغيل المحلي ولا يعمل على الموقع المنشور.
CDR_CONVERTER_PATH=

# Mada requires a persistent writable directory on a Node.js 24 server.
# Defaults to .mada/ in the project directory; use a persistent volume in production.
MADA_DATA_DIR=
# Public HTTP(S) origin, required behind a reverse proxy. No trailing path.
# Leave unset when unused; an empty or invalid value is rejected.
# MADA_PUBLIC_ORIGIN=https://mada.example.com
